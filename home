@import url('https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;600&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    margin:0;
    background:#9afcff;
    color:#063b4a;
    font-family:'Comfortaa',sans-serif;
    line-height:1.8;
}

.hero{
    background:#078ba4;
    padding:20px 20px 15px;
    text-align:center;
    border-bottom:4px solid #20ced8;
    color:white;
}

.hero h1{
    margin:0;
    font-size:2.2em;
    font-weight:600;
    letter-spacing:0;
    color:#d8f7f8;
    text-shadow:none;
}

.hero p{
    display:block;
    background:none;
    padding:0;
    margin:6px auto 15px;
    max-width:700px;
    color:#eefefe;
    font-style:italic;
    font-weight:400;
}

nav{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:40px;
    margin-top:10px;
}

nav a{
    display:inline-block;
    color:#75d9f0;
    text-decoration:none;
    font-weight:600;
    font-size:1rem;
    transition:.25s;
}

nav a:hover{
    color:#ffffff;
    text-decoration:underline;
}

.layout{
    max-width:900px;
    margin:45px auto;
    padding:0 30px;
    display:grid;
    grid-template-columns:1fr;
    gap:30px;
}

.card{
    background:#f5ffff;
    border:none;
    border-radius:22px;
    padding:22px;
    box-shadow:none;
}

.card h2{
    margin-top:0;
    margin-bottom:20px;
    background:none;
    color:#078ba4;
    border-bottom:2px solid #20ced8;
    padding-bottom:8px;
    font-size:1.35rem;
}

.card h3{
    color:#078ba4;
    margin:20px 0 10px;
}

.card p{
    margin-bottom:20px;
}

.image-box{
    width:100%;
    height:220px;
    border:2px dashed #20ced8;
    border-radius:8px;
    background:#d8f7f8;
    display:flex;
    justify-content:center;
    align-items:center;
    color:#078ba4;
    font-weight:600;
    margin:20px 0;
}

.image-box::after{
    content:"IMAGE PLACEHOLDER";
    opacity:.6;
}

.image-box.large{
    height:350px;
}

.mini-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(120px,1fr));
    gap:15px;
}

.mini-grid div{
    background:#d8f7f8;
    border:2px solid #20ced8;
    border-radius:8px;
    padding:15px;
    text-align:center;
}

.timeline{
    display:flex;
    flex-wrap:wrap;
    gap:15px;
}

.timeline span{
    flex:1;
    min-width:90px;
    background:#078ba4;
    color:white;
    padding:15px;
    text-align:center;
    border-radius:8px;
}

.glossary{
    min-height:220px;
}

@media(min-width:700px){
    .layout{
        grid-template-columns:1fr;
    }
}

footer{
    text-align:center;
    background:#078ba4;
    color:white;
    padding:20px;
    margin-top:60px;
    border-top:4px solid #20ced8;
    width:100%;
}

footer h3{
    margin:0;
    font-size:1rem;
    font-weight:400;
}
